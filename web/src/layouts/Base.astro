---
import '../styles/ruta-b.css';
import RadarDefs from '../components/RadarDefs.astro';

interface Props {
  title: string;
  description: string;
  canonical: string;
  lang?: string;
  ogLocale?: string;
  ogTitle?: string;
  jsonld?: unknown;
  hreflang?: boolean; // emit en/es/x-default alternates (home pages)
}
const {
  title, description, canonical,
  lang = 'en', ogLocale = 'en_US', ogTitle, jsonld, hreflang = false,
} = Astro.props;
// JSON-LD is embedded safely: < is escaped so the data can never close the tag.
const jsonldStr = jsonld ? JSON.stringify(jsonld).replace(/</g, '\\u003c') : null;
---
<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="theme-color" content="#FBF8F2" />
    <link rel="canonical" href={canonical} />
    {hreflang && (
      <>
        <link rel="alternate" hreflang="en" href="https://www.am-i-exposed.com/" />
        <link rel="alternate" hreflang="es" href="https://www.am-i-exposed.com/es/" />
        <link rel="alternate" hreflang="x-default" href="https://www.am-i-exposed.com/" />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Am I Exposed?" />
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=IBM+Plex+Mono:wght@500&family=Public+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    {jsonldStr && <script type="application/ld+json" set:html={jsonldStr} />}
  </head>
  <body>
    <RadarDefs />
    <slot />
  </body>
</html>
