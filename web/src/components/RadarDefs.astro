---
// Moneda radar SVG symbols (m2 still / m2a animated), from the approved brand-board.
// The 72 edge reeds are generated here at build time, so no client JS is needed.
let reeds = '';
for (let i = 0; i < 72; i++) {
  const a = (i / 72) * Math.PI * 2;
  const c = Math.cos(a);
  const s = Math.sin(a);
  reeds += `<line x1="${(50 + 41.5 * c).toFixed(2)}" y1="${(50 + 41.5 * s).toFixed(2)}" x2="${(50 + 46.5 * c).toFixed(2)}" y2="${(50 + 46.5 * s).toFixed(2)}"/>`;
}
---
<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
  <linearGradient id="coinG" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#F2CD75"/><stop offset=".55" stop-color="#D59E5D"/><stop offset="1" stop-color="#8A5A1C"/></linearGradient>
  <linearGradient id="sweepG" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#F2CD75" stop-opacity="0"/><stop offset="1" stop-color="#F2CD75" stop-opacity=".55"/></linearGradient>
  <symbol id="m2" viewBox="0 0 100 100">
    <circle cx="50" cy="50" r="47" fill="url(#coinG)"/>
    <g id="reeds" stroke="#8A5A1C" stroke-width="1.3" stroke-opacity=".75" set:html={reeds}></g>
    <circle cx="50" cy="50" r="40" fill="#0B0907"/>
    <g fill="none" stroke="#C09A6D" stroke-width="1.4" stroke-opacity=".55"><circle cx="50" cy="50" r="29"/><circle cx="50" cy="50" r="18"/></g>
    <path d="M50 50 L50 13 A37 37 0 0 1 82.04 31.5 Z" fill="url(#sweepG)"/>
    <line x1="50" y1="50" x2="82.04" y2="31.5" stroke="#F2CD75" stroke-width="3" stroke-linecap="round"/>
    <circle cx="64.1" cy="33.2" r="9" fill="#F2CD75" fill-opacity=".22"/>
    <circle cx="64.1" cy="33.2" r="4.6" fill="#F2CD75"/>
    <circle cx="50" cy="50" r="3.4" fill="#F2CD75"/>
  </symbol>
  <symbol id="m2a" viewBox="0 0 100 100">
    <circle cx="50" cy="50" r="47" fill="url(#coinG)"/>
    <use href="#reeds"/>
    <circle cx="50" cy="50" r="40" fill="#0B0907"/>
    <g fill="none" stroke="#C09A6D" stroke-width="1.4" stroke-opacity=".55"><circle cx="50" cy="50" r="29"/><circle cx="50" cy="50" r="18"/></g>
    <g class="smil">
      <circle cx="64.1" cy="33.2" r="9" fill="#F2CD75" fill-opacity=".22">
        <animate attributeName="r" values="6;6;13;6" keyTimes="0;0.944;0.97;1" dur="3s" repeatCount="indefinite"/>
        <animate attributeName="fill-opacity" values="0;0;.35;0" keyTimes="0;0.944;0.95;1" dur="3s" repeatCount="indefinite"/>
      </circle>
      <circle cx="64.1" cy="33.2" r="4.6" fill="#F2CD75">
        <animate attributeName="opacity" values="0.85;0.2;0.2;1;0.85" keyTimes="0;0.6;0.944;0.95;1" dur="3s" repeatCount="indefinite"/>
      </circle>
      <g>
        <path d="M50 50 L50 13 A37 37 0 0 1 82.04 31.5 Z" fill="url(#sweepG)"/>
        <line x1="50" y1="50" x2="82.04" y2="31.5" stroke="#F2CD75" stroke-width="3" stroke-linecap="round"/>
        <animateTransform attributeName="transform" type="rotate" from="0 50 50" to="360 50 50" dur="3s" repeatCount="indefinite"/>
      </g>
    </g>
    <circle cx="50" cy="50" r="3.4" fill="#F2CD75"/>
  </symbol>
</defs></svg>
