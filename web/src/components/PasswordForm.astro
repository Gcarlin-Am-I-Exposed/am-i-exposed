---
interface Props { lang?: 'en' | 'es'; }
const { lang = 'en' } = Astro.props;
const es = lang === 'es';
const home = es ? '/es/' : '/';

const t = es
  ? {
      title: 'Revisa una contraseña',
      sub: 'Tu contraseña nunca sale de este dispositivo. Solo enviamos los primeros 5 caracteres de su huella (k-anonymity).',
      placeholder: '••••••••••',
      btn: 'Revisar', show: 'Mostrar contraseña', hide: 'Ocultar contraseña',
      planBtn: 'Revisar mi correo también',
    }
  : {
      title: 'Check a password',
      sub: 'Your password never leaves this device. We only send the first 5 characters of its fingerprint (k-anonymity).',
      placeholder: '••••••••••',
      btn: 'Check', show: 'Show password', hide: 'Hide password',
      planBtn: 'Check my email too',
    };

// Strings the client script needs to render the result.
const rs = es
  ? {
      sev: {
        critical: { label: 'Muy alto', summary: 'Es una de las contraseñas más usadas del mundo. Está entre las primeras que prueban los delincuentes, así que cualquier cuenta que la use es muy fácil de abrir.' },
        high: { label: 'Alto', summary: 'Esta contraseña está en las listas que los delincuentes se pasan entre ellos para entrar a cuentas ajenas. Dala por pública.' },
        moderate: { label: 'Medio', summary: 'Esta contraseña se ha escapado más de una vez, así que ya está circulando, aunque no sea de las más comunes.' },
        low: { label: 'Bajo', summary: 'Esta contraseña se ha escapado solo unas pocas veces. Aun así es una vez de más, así que no conviene seguir usándola.' },
      },
      steps: [
        'Cámbiala en toda cuenta donde la hayas usado. Empieza por tu correo y después el banco. El correo es lo más importante, porque quien entra ahí puede pedir el cambio de contraseña de todo lo demás.',
        'No la vuelvas a usar en ningún lado. Los delincuentes toman una contraseña que se escapó y la prueban en cientos de sitios, a ver si la repetiste.',
        'Donde el sitio lo ofrezca, activa el segundo paso para entrar. Manda un código corto a tu teléfono después de la contraseña, y mantiene la cuenta segura incluso si alguien ya se sabe esa contraseña.',
        'Deja que tu teléfono o tu navegador recuerde las contraseñas por ti. Así cada sitio puede tener una distinta y no tienes que memorizar ninguna.',
      ],
      whatToDo: 'Qué hacer ahora',
      foundTitle: 'Esta contraseña apareció {n} veces en filtraciones conocidas.',
      cleanTitle: 'Esta contraseña no aparece',
      cleanBody: 'No la encontramos en ninguna lista de contraseñas robadas. Sigue siendo buena idea no repetirla entre sitios.',
      err: 'No pudimos revisar la contraseña. Intenta de nuevo en un momento.',
      loading: 'Revisando…',
    }
  : {
      sev: {
        critical: { label: 'Critical', summary: 'This is one of the most commonly used passwords in the world. It is among the first ones criminals try, which makes any account using it very easy to break into.' },
        high: { label: 'High', summary: 'This password appears on lists that criminals pass around and use to break into accounts. Treat it as public knowledge.' },
        moderate: { label: 'Moderate', summary: 'This password has escaped more than once, so it is out there, even though it is not one of the very common ones.' },
        low: { label: 'Low', summary: 'This password has only escaped a few times. That is still once too many, so it is not safe to keep using.' },
      },
      steps: [
        'Change it on every account where you have used it. Start with your email, then your bank. Your email matters most, because anyone who gets into it can reset the password on everything else you own.',
        'Do not use this password anywhere again. Criminals take a password that has escaped and try it on hundreds of other websites, hoping you used it twice.',
        'Where a website offers it, turn on the second step for logging in. It sends a short code to your phone after your password, and keeps the account safe even when somebody already knows that password.',
        'Let your phone or your web browser remember your passwords for you. Then every website can have a different one, and you never have to memorise any of them.',
      ],
      whatToDo: 'What to do now',
      foundTitle: 'This password has turned up {n} times in known breaches.',
      cleanTitle: 'This password does not show up',
      cleanBody: 'We did not find it in any stolen password list. It is still a good idea not to reuse it across sites.',
      err: 'We could not check that password. Please try again in a moment.',
      loading: 'Checking…',
    };
---
<div class="pw-card" id="pwCard" data-lang={lang} data-home={home}>
  <h1>{t.title}</h1>
  <p class="lede">{t.sub}</p>
  <form id="pwForm" class="pw-form">
    <div class="pw-input">
      <input type="password" id="pwInput" name="password" placeholder={t.placeholder} aria-label={t.title} autocomplete="off" />
      <button type="button" id="pwToggle" class="pw-toggle" data-show={t.show} data-hide={t.hide} aria-label={t.show}>👁</button>
    </div>
    <button class="btn primary" type="submit">{t.btn}</button>
  </form>
  <div id="pwResult" hidden></div>
</div>

<script type="application/json" id="pwI18n" set:html={JSON.stringify({ ...rs, planBtn: t.btn, whatToDo: rs.whatToDo })}></script>
<script type="application/json" id="pwLabels" set:html={JSON.stringify({ planBtn: t.planBtn })}></script>

<script>
  const card = document.getElementById('pwCard');
  const form = document.getElementById('pwForm') as HTMLFormElement | null;
  const i18nEl = document.getElementById('pwI18n');
  const labelsEl = document.getElementById('pwLabels');
  if (card && form && i18nEl && labelsEl) {
    const S = JSON.parse(i18nEl.textContent || '{}');
    const L = JSON.parse(labelsEl.textContent || '{}');
    const lang = card.getAttribute('data-lang') || 'en';
    const home = card.getAttribute('data-home') || '/';
    const input = document.getElementById('pwInput') as HTMLInputElement;
    const out = document.getElementById('pwResult') as HTMLElement;
    const toggle = document.getElementById('pwToggle') as HTMLButtonElement;

    const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#x27;' }[c] as string));
    const nfmt = (n: number) => n.toLocaleString(lang === 'es' ? 'es' : 'en');

    toggle.addEventListener('click', () => {
      const showing = input.type === 'text';
      input.type = showing ? 'password' : 'text';
      toggle.setAttribute('aria-label', showing ? toggle.dataset.show! : toggle.dataset.hide!);
    });

    async function sha1(str: string): Promise<string> {
      const buf = await crypto.subtle.digest('SHA-1', new TextEncoder().encode(str));
      return [...new Uint8Array(buf)].map((b) => b.toString(16).padStart(2, '0')).join('').toUpperCase();
    }
    async function pwned(pw: string): Promise<number> {
      const hash = await sha1(pw);
      const prefix = hash.slice(0, 5), suffix = hash.slice(5);
      const r = await fetch(`https://api.pwnedpasswords.com/range/${prefix}`, { headers: { 'Add-Padding': 'true' } });
      if (!r.ok) throw new Error(S.err);
      const text = await r.text();
      for (const line of text.split(/\r?\n/)) {
        const [cand, count] = line.split(':');
        if (cand === suffix && Number(count) > 0) return Number(count);
      }
      return 0;
    }
    function severity(n: number) {
      if (n >= 100000) return { ...S.sev.critical, bars: 5, cls: 'crit' };
      if (n >= 1000) return { ...S.sev.high, bars: 4, cls: 'high' };
      if (n >= 10) return { ...S.sev.moderate, bars: 3, cls: 'mod' };
      return { ...S.sev.low, bars: 2, cls: 'low' };
    }
    function track(resultado: string) {
      try {
        fetch('/api/track-check', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ lang, resultado, origen: 'web' }), keepalive: true,
        }).catch(() => {});
      } catch (e) { /* ignore */ }
    }
    function planCta() {
      return `<a class="btn ghost" href="${esc(home)}">${esc(L.planBtn)}</a>`;
    }
    function foundHtml(n: number) {
      const s = severity(n);
      const bars = Array.from({ length: 5 }, (_, i) =>
        `<span class="bar${i < s.bars ? ' on' : ''}"></span>`).join('');
      const steps = S.steps.map((x: string) => `<li>${esc(x)}</li>`).join('');
      return `<div class="result pw-found ${s.cls}">`
        + `<div class="pw-meter">${bars}<span class="pw-sev">${esc(s.label)}</span></div>`
        + `<h2>${esc(String(S.foundTitle).replace('{n}', nfmt(n)))}</h2>`
        + `<p>${esc(s.summary)}</p>`
        + `<h3>${esc(S.whatToDo)}</h3><ol class="steps">${steps}</ol>`
        + `<div class="ctas" style="margin-top:14px">${planCta()}</div></div>`;
    }
    function cleanHtml() {
      return `<div class="result pw-clean"><h2 style="color:var(--money)">${esc(S.cleanTitle)}</h2>`
        + `<p>${esc(S.cleanBody)}</p><div class="ctas" style="margin-top:14px">${planCta()}</div></div>`;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const pw = input.value;
      if (!pw) return;
      const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
      btn.disabled = true;
      out.hidden = false;
      out.innerHTML = `<div class="result"><p class="k" style="text-align:center">${esc(S.loading)}</p></div>`;
      try {
        const n = await pwned(pw);
        out.innerHTML = n > 0 ? foundHtml(n) : cleanHtml();
        track(n > 0 ? 'expuesto' : 'limpio');
        out.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } catch (err: any) {
        out.innerHTML = `<div class="result"><p class="k" style="color:var(--alert)">${esc(err && err.message ? err.message : S.err)}</p></div>`;
      } finally {
        btn.disabled = false;
      }
    });
  }
</script>
