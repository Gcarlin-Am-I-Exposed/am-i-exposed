---
import type { HomeStrings, Lang } from '../i18n/strings';
import { settlementIndex } from '../lib/settlements-index';
interface Props { t: HomeStrings; lang: Lang; }
const { t, lang } = Astro.props;
const es = lang === 'es';
const monitorHref = es ? '/es/monitoreo/' : '/monitoring/';
const reportHref = es ? '/es/reporte/' : '/report/';

// Real US class-action settlements keyed to a HIBP breach name. Shipped to the
// client so the scan can cross-check the visitor's breaches against real class
// actions in the browser (no email reaches a settlement call). Public facts only.
const settlements = settlementIndex();

// Strings the client script needs to render the result.
const rs = es
  ? {
      loading: 'Buscando en filtraciones conocidas…',
      alertTitle: 'Tu email apareció en una filtración',
      breachOne: 'filtración conocida expuso tu email',
      breachMany: 'filtraciones conocidas expusieron tu email',
      claimOne: 'Y en 1 podrías cobrar: hay un acuerdo abierto para el que podrías calificar.',
      claimMany: 'Y en {n} podrías cobrar: hay acuerdos abiertos para los que podrías calificar.',
      noMatch: 'Aún no hay un acuerdo colectivo abierto ligado a estas filtraciones. Activa las alertas y te avisamos apenas se abra uno.',
      sec: 'Ve cada filtración y cómo reclamar en tu reporte gratis.',
      cleanTitle: 'Buena noticia: tu email no está en ninguna filtración que seguimos.',
      cleanSub: 'Las filtraciones nuevas pasan todo el tiempo. Activa el monitoreo y te enteras primero.',
      ctaFree: 'Ver mi reporte gratis',
      ctaRelief: 'Recupera la tranquilidad, paso a paso · $5',
      ctaAlerts: 'Recibir alertas',
      note: 'Los enlaces de reclamo siempre son gratis. No guardamos tu email.',
      error: 'Algo salió mal. Inténtalo de nuevo.',
      rate: 'Demasiadas consultas. Espera un minuto e inténtalo de nuevo.',
      payFail: 'No se pudo iniciar el pago. Inténtalo de nuevo.',
      resultLabel: 'Resultado',
    }
  : {
      loading: 'Searching known breaches…',
      alertTitle: 'Your Email Appeared in a Breach',
      breachOne: 'known breach exposed your email',
      breachMany: 'known breaches exposed your email',
      claimOne: 'And 1 could pay you back: an open settlement you may qualify for.',
      claimMany: 'And {n} could pay you back: open settlements you may qualify for.',
      noMatch: 'No open class-action settlement matches these breaches yet. Turn on alerts and we tell you the moment one opens.',
      sec: 'See every breach and how to claim in your free report.',
      cleanTitle: "Good news — your email isn't in any breach we track.",
      cleanSub: 'New breaches happen all the time. Turn on monitoring and you hear first.',
      ctaFree: 'See my free full report',
      ctaRelief: 'Get relief now — step by step · $5',
      ctaAlerts: 'Get breach alerts',
      note: "Claim links are always free. We don't store your email.",
      error: 'Something went wrong. Please try again.',
      rate: 'Too many checks. Wait a minute and try again.',
      payFail: "Couldn't start checkout. Please try again.",
      resultLabel: 'Result',
    };
---
<form class="searchbar" id="scanForm" data-lang={lang} data-monitor={monitorHref} data-report={reportHref}>
  <input type="email" name="email" placeholder={t.emailPh} aria-label={t.heroCta} required autocomplete="email" />
  <button class="btn primary" type="submit" data-label={t.heroCta}>{t.heroCta}</button>
</form>
<p class="trust">{t.heroTrust}</p>
<p class="pw-link"><a href={es ? '/es/contrasena/' : '/password/'}>{es ? '¿Y una contraseña? Revísala →' : 'Check a password instead →'}</a></p>
<div id="scanResult" hidden></div>

<script type="application/json" id="scanI18n" set:html={JSON.stringify(rs)}></script>
<script type="application/json" id="scanSettlements" set:html={JSON.stringify(settlements)}></script>

<script>
  const form = document.getElementById('scanForm') as HTMLFormElement | null;
  const out = document.getElementById('scanResult') as HTMLElement | null;
  const i18nEl = document.getElementById('scanI18n');
  const idxEl = document.getElementById('scanSettlements');
  if (form && out && i18nEl) {
    const S = JSON.parse(i18nEl.textContent || '{}');
    const INDEX: any[] = JSON.parse((idxEl && idxEl.textContent) || '[]');
    const lang = form.dataset.lang || 'en';
    const monitorHref = form.dataset.monitor || '/monitoring/';
    const reportHref = form.dataset.report || '/report/';
    let currentEmail = '';
    const alertsHref = () => `${monitorHref}?email=${encodeURIComponent(currentEmail)}`;

    const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#x27;' }[c] as string));
    const coin = '<svg aria-hidden="true"><use href="#m2a"></use></svg>';
    const warn = '<svg class="exwarn" viewBox="0 0 24 24" aria-hidden="true">'
      + '<path d="M12 3 2 20h20L12 3Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>'
      + '<path d="M12 10v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>'
      + '<circle cx="12" cy="17.2" r="1.1" fill="currentColor"/></svg>';
    const year = (d: string) => (/\d{4}/.exec(d || '') || [''])[0];
    const todayISO = new Date().toISOString().slice(0, 10);

    // Cross-check the HIBP breaches against real class-action settlements, in the
    // browser. Open (still claimable) first, then by published per-person max.
    function matchSettlements(breaches: any[]) {
      const names = new Set((breaches || []).map((b) => b && b.name).filter(Boolean));
      const seen = new Set<string>();
      const items: any[] = [];
      for (const r of INDEX) {
        if (!r || !names.has(r.hibp)) continue;
        const key = r.slug || r.hibp;
        if (seen.has(key)) continue;
        seen.add(key);
        const open = !!(r.plazo && r.plazo >= todayISO);
        items.push({ ...r, status: open ? 'open' : 'closed' });
      }
      items.sort((a, b) => (a.status === b.status
        ? (b.porPersona || 0) - (a.porPersona || 0)
        : (a.status === 'open' ? -1 : 1)));
      return { items, openCount: items.filter((i) => i.status === 'open').length };
    }

    function ctas() {
      return `<div class="ctas">`
        + `<a class="btn primary" href="${esc(reportHref)}" id="freeReport">${esc(S.ctaFree)}</a>`
        + `<button class="btn gold" type="button" id="ctaReport">${esc(S.ctaRelief)}</button>`
        + `<a class="btn ghost" href="${esc(alertsHref())}">${esc(S.ctaAlerts)}</a>`
        + `</div>`;
    }
    function alertCard(inner: string) {
      return `<div class="result alert"><div class="exalert">${warn}`
        + `<span>${esc(S.alertTitle)}</span></div>${inner}`
        + `<p class="note">${esc(S.note)}</p></div>`;
    }
    function calmCard(inner: string) {
      return `<div class="result"><div class="tophead">${coin}<span>Am I Exposed?</span>`
        + `<span class="exlabel">${esc(S.resultLabel)}</span></div>${inner}`
        + `<p class="note">${esc(S.note)}</p></div>`;
    }

    function foundHtml(breaches: any[], matches: any) {
      const n = breaches.length;
      const m = matches.items.length;
      let claim: string;
      if (m > 0) {
        const chips = matches.items.slice(0, 8).map((it: any) =>
          `<span class="mchip ${it.status === 'open' ? 'open' : 'closed'}">${esc(it.empresa)}</span>`).join('');
        const claimText = m === 1 ? S.claimOne : String(S.claimMany).replace('{n}', String(m));
        claim = `<div class="claim"><p class="claim-k">${esc(claimText)}</p><div class="mchips">${chips}</div></div>`;
      } else {
        claim = `<div class="claim nomatch"><p class="claim-k">${esc(S.noMatch)}</p></div>`;
      }
      return alertCard(
        `<div class="sum"><p class="amt">${n}</p>`
        + `<p class="k">${esc(n === 1 ? S.breachOne : S.breachMany)}</p></div>`
        + claim
        + `<p class="seclabel">${esc(S.sec)}</p>` + ctas()
      );
    }
    function cleanHtml() {
      return calmCard(
        `<div class="sum"><p class="k" style="font-size:18px;color:var(--money);margin-top:4px">${esc(S.cleanTitle)}</p>`
        + `<p class="max">${esc(S.cleanSub)}</p></div>`
        + `<div class="ctas"><a class="btn gold" href="${esc(alertsHref())}">${esc(S.ctaAlerts)}</a></div>`
      );
    }
    function loadingHtml() {
      return `<div class="result"><div class="sum" style="padding:32px 18px">`
        + `<div style="width:56px;height:56px;margin:0 auto 12px">${coin}</div>`
        + `<p class="k">${esc(S.loading)}</p></div></div>`;
    }

    async function startCheckout(email: string) {
      try {
        const r = await fetch('/api/checkout?plan=report', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ lang, email }),
        });
        const data = await r.json().catch(() => null);
        if (!r.ok || !data || !data.url) throw new Error((data && data.error) || S.payFail);
        window.location.href = data.url;
      } catch (err: any) {
        alert(err && err.message ? err.message : S.payFail);
      }
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = form.querySelector('input[name=email]') as HTMLInputElement;
      const btn = form.querySelector('button') as HTMLButtonElement;
      const email = (input.value || '').trim();
      if (!email) return;
      currentEmail = email;
      btn.disabled = true; btn.textContent = '…';
      out.hidden = false; out.innerHTML = loadingHtml();
      try {
        const r = await fetch('/api/check-email', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, lang, origen: 'web' }),
        });
        const data = await r.json().catch(() => ({}));
        if (r.status === 429) throw new Error(S.rate);
        if (!r.ok) throw new Error(data.error || S.error);
        const breaches = data.found && Array.isArray(data.breaches) ? data.breaches : [];
        if (breaches.length) {
          const matches = matchSettlements(breaches);
          // Hand the result to the free report page via sessionStorage (same tab,
          // same origin, cleared on close): no email in any URL, nothing stored
          // server-side, no second HIBP call.
          try {
            sessionStorage.setItem('aie:report', JSON.stringify({
              email, lang, breaches, matches: matches.items, openCount: matches.openCount, ts: Date.now(),
            }));
          } catch (e) { /* private mode: free report falls back to a re-scan prompt */ }
          out.innerHTML = foundHtml(breaches, matches);
          const rep = document.getElementById('ctaReport');
          if (rep) rep.addEventListener('click', () => startCheckout(email));
        } else {
          out.innerHTML = cleanHtml();
        }
        out.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } catch (err: any) {
        out.innerHTML = `<div class="result"><div class="sum"><p class="k" style="color:var(--alert)">`
          + esc(err && err.message ? err.message : S.error) + `</p></div></div>`;
      } finally {
        btn.disabled = false; btn.textContent = btn.dataset.label || 'Check';
      }
    });
  }
</script>
