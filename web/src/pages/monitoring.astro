---
import Base from '../layouts/Base.astro';
import ContentChrome from '../components/ContentChrome.astro';
import MonitorForm from '../components/MonitorForm.astro';
---
<Base
  title="Breach & settlement monitoring | Am I Exposed?"
  description="Turn on monitoring: we email you the moment a new breach includes your email or a new settlement opens that you may qualify for. 14-day free trial, cancel in one click."
  canonical="https://www.am-i-exposed.com/monitoring/"
  lang="en"
  ogLocale="en_US"
>
  <ContentChrome lang="en">
    <main class="wrap article" style="max-width:640px"><MonitorForm lang="en" /></main>
  </ContentChrome>
</Base>
