---
import Base from '../layouts/Base.astro';
import ContentChrome from '../components/ContentChrome.astro';
import body from '../content/what-to-do-if-your-email-was-leaked.html?raw';
import meta from '../content/article-meta.json';
const m = (meta as Record<string, any>)['what-to-do-if-your-email-was-leaked'];
---
<Base title={m.title} description={m.desc} canonical={m.canonical} lang={m.lang} ogLocale={m.ogLocale}>
  <ContentChrome lang={m.lang}>
    <main class="wrap article" set:html={body}></main>
  </ContentChrome>
</Base>
