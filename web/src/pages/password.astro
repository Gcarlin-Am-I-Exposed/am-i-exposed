---
import Base from '../layouts/Base.astro';
import ContentChrome from '../components/ContentChrome.astro';
import PasswordForm from '../components/PasswordForm.astro';
---
<Base
  title="Check if your password was leaked | Am I Exposed?"
  description="Check any password against known breaches, privately. Your password never leaves your device (k-anonymity). Free, no account."
  canonical="https://www.am-i-exposed.com/password/"
  lang="en"
  ogLocale="en_US"
>
  <ContentChrome lang="en">
    <main class="wrap article" style="max-width:640px"><PasswordForm lang="en" /></main>
  </ContentChrome>
</Base>
