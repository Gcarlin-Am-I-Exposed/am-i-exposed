---
import Base from '../layouts/Base.astro';
import Home from '../components/Home.astro';
import { strings } from '../i18n/strings';
const t = strings.en;
---
<Base
  title={t.title}
  description={t.metaDesc}
  canonical="https://www.am-i-exposed.com/"
  lang={t.htmlLang}
  ogLocale={t.ogLocale}
  hreflang={true}
>
  <Home t={t} lang="en" />
</Base>
