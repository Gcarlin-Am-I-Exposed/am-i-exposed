---
import Base from '../../layouts/Base.astro';
import ContentChrome from '../../components/ContentChrome.astro';
import body from '../../content/que-hacer-si-se-filtro-mi-correo.html?raw';
import meta from '../../content/article-meta.json';
const m = (meta as Record<string, any>)['que-hacer-si-se-filtro-mi-correo'];
---
<Base title={m.title} description={m.desc} canonical={m.canonical} lang={m.lang} ogLocale={m.ogLocale}>
